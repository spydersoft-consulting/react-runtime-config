{
  "name": "@spydersoft/react-runtime-config",
  "version": "3.0.2",
  "description": "Provide a typesafe runtime configuration inside a react app",
  "repository": {
    "type": "git",
    "url": "git@github.com:spydersoft-consulting/react-runtime-config.git"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "jest --watch",
    "test": "jest",
    "build": "tsc -p tsconfig.package.json",
    "ci": "yarn test --ci --coverage && yarn build",
    "format": "eslint src/*.{ts,tsx} --fix && prettier src/*.{ts,tsx,json} --write",
    "prepare": "husky"
  },
  "keywords": [
    "typescript",
    "react",
    "config",
    "configuration",
    "runtime"
  ],
  "author": "Fabien Bernard <fabien@contiamo.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sonarjs": "^3.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^4.0.1",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.5",
    "ts-mockery": "^1.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "packageManager": "yarn@3.6.0"
}
